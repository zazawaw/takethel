mkSection(tReacts,"Auto React")
mkParagraph(tReacts,"✅ TURN THIS ON","Fires once the moment the ball enters your range — like your foot naturally meeting the ball. Keep distance 3–4.")
mkToggle(tReacts,"Enable Auto React","Fires once on ball entry into range",false,function(state)
    rcAutoOn=state; updateReachGate()
    if rcAutoConn then rcAutoConn:Disconnect(); rcAutoConn=nil end
    rcAutoPrevDist=math.huge
    if not state then rcBusy=false; notify("Auto React","OFF",false) return end
    rcAutoConn=RunService.Heartbeat:Connect(function()
        local c=lplr.Character; local root=c and c:FindFirstChild("HumanoidRootPart")
        local hum=c and c:FindFirstChildOfClass("Humanoid")
        if not(c and root and hum) then return end
        local TPS=GetTPS(); if not TPS then return end
        local dist=(root.Position-TPS.Position).Magnitude
        local wasOutside=rcAutoPrevDist>rcAutoDist
        local nowInside=dist<=rcAutoDist*1.15  -- 15% buffer catches fast sprinting
        rcAutoPrevDist=dist
        if wasOutside and nowInside then
            local delay=0.04+math.random()*0.07
            task.delay(delay,function()
                if not canFireReact() then return end
                local c2=lplr.Character; local r2=c2 and c2:FindFirstChild("HumanoidRootPart")
                local h2=c2 and c2:FindFirstChildOfClass("Humanoid")
                if not(c2 and r2 and h2) then return end
                local t2=GetTPS(); if not t2 then return end
                -- use slightly wider check on fire to match buffer
                if (r2.Position-t2.Position).Magnitude>rcAutoDist*1.15 then return end
                doReact(c2,h2,t2)
            end)
        end
    end)
    notify("Auto React","ON ✅",true)
end)


mkSection(tReacts,"Smart React")
mkParagraph(tReacts,"❌ LEAVE OFF","Only fires when ball is coming directly at you. Touch React + Anim React already covers this better.")
local smartConn=nil
local smartDist=5

mkToggle(tReacts,"Smart React","Only reacts when ball is heading toward you",false,function(state)
    smartOn=state; updateReachGate()
    if smartConn then smartConn:Disconnect(); smartConn=nil end
    if not state then rcBusy=false; notify("Smart React","OFF",false) return end
    smartConn=RunService.Heartbeat:Connect(function()
        if not canFireReact() then return end
        local c=lplr.Character
        local root=c and c:FindFirstChild("HumanoidRootPart")
        local hum=c and c:FindFirstChildOfClass("Humanoid")
        if not(c and root and hum) then return end
        local TPS=GetTPS(); if not TPS then return end
        local dist=(root.Position-TPS.Position).Magnitude
        if dist>smartDist then return end
        local toPlayer=(root.Position-TPS.Position).Unit
        local ballVel=TPS.AssemblyLinearVelocity
        if ballVel.Magnitude<0.5 then return end
        if toPlayer:Dot(ballVel.Unit)>0.55 then
            doReact(c,hum,TPS)
        end
    end)
    notify("Smart React","ON",true)
end)


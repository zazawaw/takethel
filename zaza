    local dot=Instance.new("Frame"); dot.Size=UDim2.new(0,5,0,5); dot.Position=UDim2.new(0,11,0.5,-2.5)
    dot.BackgroundColor3=good~=false and CON or COFF; dot.BorderSizePixel=0; dot.Parent=f; mkCorner(dot,3)
    local tl=Instance.new("TextLabel"); tl.Size=UDim2.new(1,-24,0,22); tl.Position=UDim2.new(0,22,0,4)
    tl.BackgroundTransparency=1; tl.Text=title; tl.TextSize=13; tl.Font=Enum.Font.GothamBold
    tl.TextColor3=TXT; tl.TextXAlignment=Enum.TextXAlignment.Left; tl.Parent=f
    local dl=Instance.new("TextLabel"); dl.Size=UDim2.new(1,-24,0,18); dl.Position=UDim2.new(0,22,0,28)
    dl.BackgroundTransparency=1; dl.Text=desc or ""; dl.TextSize=11; dl.Font=Enum.Font.Gotham
    dl.TextColor3=SUB; dl.TextXAlignment=Enum.TextXAlignment.Left; dl.Parent=f
    TweenService:Create(f,TweenInfo.new(0.25,Enum.EasingStyle.Back),{Position=UDim2.new(0.5,-125,0,14)}):Play()
    task.delay(2.5,function()
        TweenService:Create(f,TweenInfo.new(0.2),{Position=UDim2.new(0.5,-125,0,-70)}):Play()
        task.wait(0.25); gui:Destroy()
    end)

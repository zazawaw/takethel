-- Dialga-style multi-box moss:
-- Uses 4 overlapping invisible parts:
--   [1] Main box — centered on head
--   [2] Forward box — offset in front, catches incoming balls
--   [3] Wide box — thin but wide, catches crosses and aerials
--   [4] Low box — below head, catches neck-height crosses

local mossBoxes   = {}   -- holds all active parts
local mossConn    = nil
local mossSize    = 5    -- preset scale (1–10)
local mossVisible = false -- debug visibility

-- Box layout relative to head center (offset, size multipliers)
local MOSS_LAYOUT = {
    -- {offsetCF, sizeMultX, sizeMultY, sizeMultZ}
    { CFrame.new(0,  0.0,  0),    1.0, 1.0, 1.0 },   -- main center box
    { CFrame.new(0,  0.0, -0.6),  0.8, 0.7, 0.8 },   -- forward (ball coming at face)
    { CFrame.new(0,  0.2,  0),    1.4, 0.5, 1.4 },   -- wide flat top (crosses/aerials)
    { CFrame.new(0, -0.5,  0),    1.1, 0.6, 1.1 },   -- low box (neck height crosses)
}

local function mossBaseSize()
    local s = mossSize * 0.18
    return Vector3.new(s, s, s)
end

local function destroyMoss()
    for _, p in ipairs(mossBoxes) do
        pcall(function() p:Destroy() end)
    end
    mossBoxes = {}
    if mossConn then mossConn:Disconnect(); mossConn = nil end
end

local function rebuildHead()
    destroyMoss()
    if not headOn then return end
    local base = mossBaseSize()
    for _, layout in ipairs(MOSS_LAYOUT) do
        local offsetCF, mx, my, mz = layout[1], layout[2], layout[3], layout[4]
        local p = Instance.new("Part")
        p.Size = Vector3.new(base.X*mx, base.Y*my, base.Z*mz)
        p.Anchored = true
        p.CanCollide = false
        p.Transparency = mossVisible and 0.5 or 1
        p.Color = Color3.fromRGB(255, 105, 180)
        p.CastShadow = false
        p.Parent = workspace
        table.insert(mossBoxes, p)
    end

    mossConn = RunService.RenderStepped:Connect(function()
        local c = lplr.Character
        local h = c and c:FindFirstChild("Head")
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        if not (c and h and hum) then return end

        local headCF = h.CFrame
        local base2 = mossBaseSize()
        local TPS = GetTPS()

        for i, layout in ipairs(MOSS_LAYOUT) do
            local p = mossBoxes[i]
            if not (p and p.Parent) then continue end
            local offsetCF, mx, my, mz = layout[1], layout[2], layout[3], layout[4]
            p.CFrame = headCF * offsetCF
            p.Size = Vector3.new(base2.X*mx, base2.Y*my, base2.Z*mz)

            -- check if this box is touching ball
            if TPS then
                local dist = (p.Position - TPS.Position).Magnitude
                local threshold = (p.Size.X/2 + TPS.Size.X/2) * 1.1
                if dist < threshold then
                    doReact(c, hum, TPS)
                end
            end
        end
    end)
end


local tackling    = false

local function canFireReact()
    local now = tick()
    if not anyReachActive then return false end
    if tackling then return false end
    if rcBusy and (now - rcLastFired) > 1.5 then rcBusy = false end
    if rcBusy then return false end
    if (now - rcLastFired) < RC_MIN then return false end
    return true
end

-- React queue — if a react is blocked by cooldown, queue it
-- so it fires as soon as the cooldown clears. Gives near 100% react rate.
local rcQueue = false
local function queueReact(c, hum, TPS)
    if canFireReact() then
        -- fire immediately
        local limb = GetLimb(c, hum); if not limb then return end
        rcBusy = true; rcLastFired = tick()
        firetouchinterest(limb, TPS, 0); firetouchinterest(limb, TPS, 1)
        local nw = RC_MIN + math.random() * (RC_MAX - RC_MIN)
        task.delay(nw, function() rcBusy = false end)
    elseif not rcQueue and anyReachActive and not tackling then
        -- queue it — fire once cooldown clears
        rcQueue = true
        local queuedAt = tick()
        task.delay(RC_MAX + 0.05, function()
            rcQueue = false
            if not anyReachActive or tackling then return end
            -- drop if queued too long (ball probably moved away)
            if tick() - queuedAt > 0.6 then return end
            local t2 = GetTPS(); if not t2 then return end
            local c2 = lplr.Character; local r2 = c2 and c2:FindFirstChild("HumanoidRootPart")
            local h2 = c2 and c2:FindFirstChildOfClass("Humanoid")
            if not (c2 and r2 and h2) then return end
            -- use reachDist + small buffer as max distance for queued react
            local maxDist = math.max(reachDist + 1.5, 5)
            if (r2.Position - t2.Position).Magnitude > maxDist then return end
            if not canFireReact() then return end
            local limb = GetLimb(c2, h2); if not limb then return end
            rcBusy = true; rcLastFired = tick()
            firetouchinterest(limb, t2, 0); firetouchinterest(limb, t2, 1)
            local nw = RC_MIN + math.random() * (RC_MAX - RC_MIN)
            task.delay(nw, function() rcBusy = false end)
        end)
    end
end

local function doReact(c, hum, TPS)
    queueReact(c, hum, TPS)
end


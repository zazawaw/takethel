-- ── Touch React ────────────────────────────────────────────
mkSection(tReacts,"Touch React")
mkParagraph(tReacts,"✅ TURN THIS ON","Best react. Only fires on real ball contact — server sees it as a completely normal touch. Always have this on.")

local function hookTouchReact()
    if rcTouchConn then rcTouchConn:Disconnect(); rcTouchConn=nil end
    if not touchReactOn then return end
    local TPS=GetTPS(); if not TPS then
        -- ball not found yet, retry shortly
        task.delay(1, hookTouchReact); return
    end
    rcTouchConn=TPS.Touched:Connect(function(hit)
        local c=lplr.Character; if not c then return end
        if not hit:IsDescendantOf(c) then return end
        local hum=c:FindFirstChildOfClass("Humanoid"); if not hum then return end
        local t=GetTPS(); if not t then return end
        local root=c:FindFirstChild("HumanoidRootPart"); if not root then return end
        if (root.Position - t.Position).Magnitude > 5.5 then return end
        doReact(c, hum, t)
    end)
    -- if ball gets replaced mid-game re-hook automatically
    TPS.AncestryChanged:Connect(function()
        if not touchReactOn then return end
        task.delay(0.5, hookTouchReact)
    end)
end

mkToggle(tReacts,"Enable Touch React","Fires on real ball contact",false,function(state)
    touchReactOn = state
    if not state then
        if rcTouchConn then rcTouchConn:Disconnect(); rcTouchConn=nil end
        updateReachGate(); notify("Touch React","OFF",false); return
    end
    hookTouchReact()
    updateReachGate()
    notify("Touch React","ON ✅",true)
end)


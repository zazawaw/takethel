local function rebuildReach()
    if reachConn then reachConn:Disconnect(); reachConn=nil end
    if not reachOn then return end
    reachConn=RunService.RenderStepped:Connect(function()
        local c=lplr.Character; local root=c and c:FindFirstChild("HumanoidRootPart")
